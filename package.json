{
  "name": "beam.com",
  "version": "0.1.0-rc.4",
  "description": "Erlang/OTP and Elixir in one executable file: npx beam.com, and the WebAssembly runtime for a native app.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sntran/BEAM.com.git"
  },
  "homepage": "https://github.com/sntran/BEAM.com#readme",
  "engines": {
    "node": ">=25"
  },
  "bin": {
    "beam.com": "js/beam.com.mjs"
  },
  "exports": {
    ".": {
      "workerd": "./runtime/cloudflare/index.js",
      "deno": "./runtime/deno.js",
      "node": "./js/node.mjs",
      "default": "./js/node.mjs"
    },
    "./app-com": "./runtime/app-com.js",
    "./runtime-id": "./runtime/runtime-id.js",
    "./worker": "./runtime/worker.js",
    "./beam.wasm": "./runtime/beam.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "js/",
    "runtime/",
    "LICENSE",
    "NOTICE"
  ]
}
