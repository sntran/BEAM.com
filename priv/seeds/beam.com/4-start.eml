hex: ^(?<hex>[01])$
rebar3: ^(?<rebar3>[01])$
elixir: ^(?<elixir>[01])$
jit: ^(?<jit>[01])$
sqlite: ^(?<sqlite>[01])$
wasm: ^(?<wasm>[01])$
otp_version: ^(?<otp_version>|[0-9]{2}\.[0-9]{1,3}(?:\.[0-9]{1,3}){0,2})$
