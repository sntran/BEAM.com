To: -
Content-Type: text/html; charset=utf-8
Cache-Control: no-store

<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Start the build</title>
<style>:root { color-scheme: light dark; } body { margin: 0; font: 16px/1.5 system-ui, sans-serif; } main { max-width: 40rem; margin: 0 auto; padding: 2rem 1rem; } th { text-align: left; padding-right: 1rem; } button { margin-top: 1rem; padding: .625rem 1.25rem; font: inherit; font-weight: 600; color: #fff; background: #7b2ff7; border: 0; border-radius: .375rem; cursor: pointer; }</style></head>
<body><main>
<h1>Start the build</h1>
<table>
<tr><th>Email</th><td>$email</td></tr>
<tr><th>Default OTP applications that stay</th><td>$k_parsetools $k_asn1 $k_public_key $k_ssl $k_inets $k_ssh $k_xmerl $k_runtime_tools $k_tools</td></tr>
<tr><th>More OTP applications</th><td>$apps $a_mnesia $a_os_mon $a_eldap $a_ftp $a_tftp $a_diameter $a_eunit $a_common_test $a_syntax_tools $a_edoc</td></tr>
<tr><th>Elixir</th><td>$elixir</td></tr>
<tr><th>Hex</th><td>$hex</td></tr>
<tr><th>rebar3</th><td>$rebar3</td></tr>
<tr><th>More NIFs</th><td>$nif1 $nif2 $nif3</td></tr>
<tr><th>JIT</th><td>$jit</td></tr>
<tr><th>SQLite</th><td>$sqlite</td></tr>
<tr><th>WebAssembly</th><td>$wasm</td></tr>
</table>
<p>1 means yes, and 0 means no.</p>
<form method="post" action="/beam.com">
<input type="hidden" name="step" value="start">
<input type="hidden" name="email" value="$email">
<input type="hidden" name="apps" value="$apps $a_mnesia $a_os_mon $a_eldap $a_ftp $a_tftp $a_diameter $a_eunit $a_common_test $a_syntax_tools $a_edoc">
<input type="hidden" name="keep" value="$otp $k_parsetools $k_asn1 $k_public_key $k_ssl $k_inets $k_ssh $k_xmerl $k_runtime_tools $k_tools">
<input type="hidden" name="hex" value="$hex">
<input type="hidden" name="rebar3" value="$rebar3">
<input type="hidden" name="elixir" value="$elixir">
<input type="hidden" name="jit" value="$jit">
<input type="hidden" name="sqlite" value="$sqlite">
<input type="hidden" name="wasm" value="$wasm">
<input type="hidden" name="nifs" value="$nif1 $nif2 $nif3">
<input type="hidden" name="code" value="$code">
<button>Start the build</button>
</form>
</main></body>
</html>
