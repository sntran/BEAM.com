// The VM in the Worker (no binding BEAM), and the ports in their own
// objects.
{
  "name": "ports-check-plain",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["no_handle_cross_request_promise_resolution"],
  "rules": [{ "type": "Data", "globs": ["**/*.com"], "fallthrough": true }],
  "durable_objects": { "bindings": [
    { "name": "ECHO", "class_name": "Echo" },
    { "name": "SINK", "class_name": "Sink" },
    { "name": "SOURCE", "class_name": "Source" }
  ] },
  // A service binding to an entrypoint of this Worker: a port with no
  // class of a Durable Object, so with no migration.
  "services": [{ "binding": "ECHO_ENTRY", "service": "ports-check-plain", "entrypoint": "EchoEntry" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Beam", "Echo", "Sink", "Source"] }]
}
