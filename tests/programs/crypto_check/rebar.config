%% An example release that uses crypto, to add to BEAM.com.
%%
%% The Erlang code of crypto comes from the OTP that builds the release.
%% Its NIF is linked into beam.com (a static NIF), so the release does not
%% need the crypto.so file from priv/lib.
%%
%%   rebar3 release
%%   cd _build/default/rel/crypto_check
%%   cp beam.com crypto_check.com
%%   zip -r crypto_check.com releases lib
{erl_opts, [debug_info]}.
{deps, []}.
{relx, [{release, {crypto_check, "1.0.0"}, [crypto, crypto_check]},
        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"},
        {include_erts, false},
        {include_src, false},
        {dev_mode, false},
        {extended_start_script, false}]}.
