+/// WebAssembly: the functions are imports of the module "env".
+pub struct ImportsBuilder<'a>(&'a mut String);
+impl ApiBuilder for ImportsBuilder<'_> {
+    fn init(&mut self) {
+        writeln!(self.0, "mod wasm_imports {{\n    #![allow(dead_code)]\n    use super::*;\n    extern \"C\" {{").unwrap();
+    }
+    fn finish(&mut self) {
+        writeln!(self.0, "    }}\n}}").unwrap();
+    }
+    fn func(&mut self, ret: &str, name: &str, args: &str) {
+        write!(self.0, "        pub fn {name}({args})").unwrap();
+        write_ret(self.0, ret);
+        writeln!(self.0, ";").unwrap();
+    }
+    fn variadic_func(&mut self, ret: &str, name: &str, args: &str) {
+        write!(self.0, "        pub fn {name}({args}, ...)").unwrap();
+        write_ret(self.0, ret);
+        writeln!(self.0, ";").unwrap();
+    }
+    fn dummy(&mut self, _name: &str) {}
+}
+
+pub struct WasmWriterBuilder<'a>(&'a mut String);
+impl ApiBuilder for WasmWriterBuilder<'_> {
+    fn init(&mut self) {
+        write!(
+            self.0,
+            "impl DynNifCallbacks {{\n    fn write_symbols<T: DynNifFiller>(&mut self, _filler: T) {{\n"
+        )
+        .unwrap();
+    }
+    fn finish(&mut self) {
+        writeln!(self.0, "    }}\n}}").unwrap();
+    }
+    fn func(&mut self, _ret: &str, name: &str, _args: &str) {
+        writeln!(
+            self.0,
+            "        self.{name} = Some(unsafe {{ std::mem::transmute(wasm_imports::{name} as *const ()) }});"
+        )
+        .unwrap();
+    }
+    fn variadic_func(&mut self, ret: &str, name: &str, args: &str) {
+        self.func(ret, name, args);
+    }
+    fn dummy(&mut self, _name: &str) {}
+}
+
 fn generate(opts: &GenerateOptions) -> String {
     let mut out = String::new();
 
