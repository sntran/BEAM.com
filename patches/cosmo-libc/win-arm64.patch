+  int64_t h;
+  intptr_t tip;
+  uint32_t utid;
+  struct CloneArgs *wt;
+  sp = tip = (intptr_t)stk + stksz;
+  sp -= sizeof(struct CloneArgs);
+  sp &= -alignof(struct CloneArgs);
+  wt = (struct CloneArgs *)sp;
+  wt->ctid = ctid;
+  wt->ptid = ptid;
+  wt->func = func;
+  wt->arg = arg;
+  wt->tls = tls;
+  wt->sp = tip & -16;
