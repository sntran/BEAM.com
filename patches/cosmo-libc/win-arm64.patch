+                        kNtStackSizeParamIsAReservation, &utid))) {
+    atomic_init(ptid, utid);
+    struct CosmoTib *tib = tls;
+    atomic_store_explicit(&tib[-1].tib_syshand, h, memory_order_release);
+    return 0;
+  } else {
