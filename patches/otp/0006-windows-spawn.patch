+#ifdef __COSMOPOLITAN__
+/*
+ * BEAM.com: port programs on Windows (docs/UPSTREAM.md, C16).
+ *
+ * erl_child_setup cannot work on Windows: Cosmopolitan cannot pass a file
+ * descriptor to another process. So the spawn driver starts the program
+ * itself with posix_spawn() (beam_com_spawn_nt() of beam_com.c), and it
+ * knows the pid at once. The pipes have O_CLOEXEC, so another program does
+ * not get them; posix_spawn() gives the ends of the child as its fds.
+ *
+ * - No message "Go" comes on the output of the program. The pid stays in
+ *   beam_com_pid, and dd->pid stays 0, until the ack: the first event of
+ *   the port (ready_input, or the timer of 0 ms of spawn_timeout_nt) calls
+ *   spawn_ack_nt(). An ack in spawn_start is not possible: the open of the
+ *   port gets its reference after spawn_start.
+ * - A thread for each program waits for its end, and writes the exit
+ *   status to the pipe of the forker port (beam_com_sigchld_wfd). The
+ *   forker port gives it to the spawn port, as for erl_child_setup.
+ */
+#include <pthread.h>
+
+/* c_src/cosmo/beam_com_pipe.c: a query handle of the read end of the
+ * input pipe of the program, for the free space of the pipe. */
+void beam_com_pipe_reader(int wfd, int rfd) __attribute__((__weak__));
+
+struct spawn_wait_nt {
+    int pid;
+    Eterm port_id;
+};
+
+/* The wait status of the exit code of a Windows process. A program of
+ * Cosmopolitan exits with the wait status (code << 8); another program
+ * exits with the code. */
+static int spawn_status_nt(int code)
+{
+    if ((code & 0xff) == 0 && code >= 0 && code <= 0xff00)
+        return code;
+    if (code > 0 && code <= 0xff)
+        return code << 8;
+    return 0xff00;
+}
+
+static void *spawn_wait_nt(void *arg)
+{
+    struct spawn_wait_nt w = *(struct spawn_wait_nt *)arg;
+    ErtsSysForkerProto proto;
+    int status = 0;
+
+    free(arg);
+    while (waitpid(w.pid, &status, 0) < 0 && errno == EINTR)
+        ;
+    if (w.port_id != THE_NON_VALUE) {
+        memset(&proto, 0, sizeof(proto));
+        proto.action = ErtsSysForkerProtoAction_SigChld;
+        proto.u.sigchld.port_id = w.port_id;
+        proto.u.sigchld.error_number = spawn_status_nt(status);
+        /* Less than PIPE_BUF bytes: one write of the whole message. */
+        if (write(beam_com_sigchld_wfd, &proto, sizeof(proto)) < 0)
+            ; /* The emulator stops. */
+    }
+    return NULL;
+}
+
+static void spawn_ack_nt(ErtsSysDriverData *dd)
+{
+    ErlDrvPort port_num = dd->port_num;
+
+    driver_cancel_timer(port_num);
+    dd->pid = dd->beam_com_pid;
+    if (dd->ifd && dd->ifd->fd < 0) {
+        driver_select(port_num, abs(dd->ifd->fd), ERL_DRV_READ|ERL_DRV_USE, 0);
+        erts_atomic_add_nob(&sys_misc_mem_sz, -sizeof(ErtsSysFdData));
+        dd->ifd = NULL;
+    }
+    if (dd->ofd && dd->ofd->fd < 0)
+        /* No writes: select only to close the fd. */
+        driver_select(port_num, abs(dd->ofd->fd), ERL_DRV_WRITE|ERL_DRV_USE, 1);
+    erl_drv_set_os_pid(port_num, dd->pid);
+    erl_drv_init_ack(port_num, (ErlDrvData)dd);
+}
+
+static void spawn_timeout_nt(ErlDrvData e)
+{
+    ErtsSysDriverData *dd = (ErtsSysDriverData*)e;
+
+    if (dd->pid == 0 && dd->beam_com_pid)
+        spawn_ack_nt(dd);
+}
+
+static ErlDrvData spawn_start_nt(ErlDrvPort port_num, char* name,
+                                 SysDriverOpts* opts)
+{
+    static int forker_selected;
+    ErtsSysDriverData *dd;
+    char wd_buff[MAXPATHLEN+1];
+    char *cwd, **argv = NULL, **envp;
+    char *argv1[2];
+    void *env_block;
+    struct iovec *iov;
+    int ifd[2], ofd[2], i = 0, j, err, pid = 0;
+    Sint32 env_size = 0;
+    int do_read = (opts->read_write & DO_READ) != 0;
+    int do_write = (opts->read_write & DO_WRITE) != 0;
+
+    if (pipe2(ifd, O_CLOEXEC) < 0)
+        return ERL_DRV_ERROR_ERRNO;
+    if (pipe2(ofd, O_CLOEXEC) < 0) {
+        err = errno;
+        close(ifd[0]);
+        close(ifd[1]);
+        errno = err;
+        return ERL_DRV_ERROR_ERRNO;
+    }
+    if (ifd[0] >= sys_max_files() || ifd[1] >= sys_max_files()
+        || ofd[0] >= sys_max_files() || ofd[1] >= sys_max_files()) {
+        close_pipes(ifd, ofd);
+        errno = EMFILE;
+        return ERL_DRV_ERROR_ERRNO;
+    }
+    /* Non-blocking, as on Unix. A non-blocking write to a pipe of
+     * Cosmopolitan on Windows that does not fit in the pipe can lose data,
+     * and select() reports a full pipe as writable. The wraps of write(),
+     * writev() and select() in c_src/cosmo/beam_com_pipe.c prevent both.
+     * The free space of the write end is 0 while the program waits in a
+     * large read, so the wraps read the free space from the read end. */
+    SET_NONBLOCKING(ifd[0]);
+    SET_NONBLOCKING(ofd[1]);
+    if (beam_com_pipe_reader)
+        beam_com_pipe_reader(ofd[1], ofd[0]);
+
+    if (opts->spawn_type == ERTS_SPAWN_EXECUTABLE) {
+        if (access(beam_com_exec_path(name), X_OK) != 0) {
+            err = errno;
+            close_pipes(ifd, ofd);
+            errno = err;
+            return ERL_DRV_ERROR_ERRNO;
+        }
+        if (opts->argv) {
+            /* A copy: the caller frees opts->argv. */
+            for (j = 0; opts->argv[j]; j++)
+                ;
+            argv = erts_alloc(ERTS_ALC_T_TMP, sizeof(char*) * (j + 1));
+            for (j = 0; opts->argv[j]; j++)
+                argv[j] = opts->argv[j] == erts_default_arg0 ? name : opts->argv[j];
+            argv[j] = NULL;
+        } else {
+            argv1[0] = name;
+            argv1[1] = NULL;
+            argv = argv1;
+        }
+    }
+
+    if ((cwd = getcwd(wd_buff, MAXPATHLEN+1)) == NULL) {
+        err = errno;
+        close_pipes(ifd, ofd);
+        if (argv && argv != argv1)
+            erts_free(ERTS_ALC_T_TMP, argv);
+        errno = err;
+        return ERL_DRV_ERROR_ERRNO;
+    }
+
+    iov = erts_alloc(ERTS_ALC_T_TMP,
+                     sizeof(struct iovec) * (opts->envir.variable_count + 1));
+    env_block = add_spawn_env_block(&opts->envir, iov, &i, &env_size);
+    envp = erts_alloc(ERTS_ALC_T_TMP, sizeof(char*) * (i + 1));
+    for (j = 0; j < i; j++)
+        envp[j] = iov[j].iov_base;
+    envp[i] = NULL;
+
+    err = beam_com_spawn_nt(name, argv, envp, cwd, opts->wd,
+                            do_write ? ofd[0] : -1, do_read ? ifd[1] : -1,
+                            opts->redir_stderr ? ifd[1] : -1,
+                            opts->use_stdio, &pid);
+
+    if (argv && argv != argv1)
+        erts_free(ERTS_ALC_T_TMP, argv);
+    erts_free(ERTS_ALC_T_TMP, envp);
+    erts_free(ERTS_ALC_T_TMP, iov);
+    erts_free(ERTS_ALC_T_TMP, env_block);
+    /* The child has its own copies of these ends. */
+    close(ofd[0]);
+    close(ifd[1]);
+    if (err) {
+        close(ifd[0]);
+        close(ofd[1]);
+        errno = err;
+        return ERL_DRV_ERROR_ERRNO;
+    }
+
+    dd = create_driver_data(port_num, ifd[0], ofd[1], opts->packet_bytes,
+                            DO_WRITE | DO_READ, opts->exit_status,
+                            0, 0, opts);
+    dd->beam_com_pid = pid;
+    if (!do_read)
+        dd->ifd->fd *= -1;
+    if (!do_write)
+        dd->ofd->fd *= -1;
+
+    {
+        struct spawn_wait_nt *w = malloc(sizeof(*w));
+        pthread_attr_t attr;
+        pthread_t tid;
+        if (w) {
+            w->pid = pid;
+            w->port_id = opts->exit_status ? erts_drvport2id(port_num)
+                                           : THE_NON_VALUE;
+            pthread_attr_init(&attr);
+            pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+            pthread_attr_setstacksize(&attr, 65536);
+            if (pthread_create(&tid, &attr, spawn_wait_nt, w) != 0)
+                free(w);
+            pthread_attr_destroy(&attr);
+        }
+    }
+
+    if (!forker_selected) {
+        /* The forker port selects the pipe of the exit statuses. */
+        ErtsSysForkerProto *proto =
+            erts_alloc(ERTS_ALC_T_DRV_CTRL_DATA, sizeof(ErtsSysForkerProto));
+        memset(proto, 0, sizeof(ErtsSysForkerProto));
+        proto->action = ErtsSysForkerProtoAction_Start;
+        proto->u.start.port_id = THE_NON_VALUE;
+        forker_selected = 1;
+        erl_drv_port_control(forker_port, ERTS_FORKER_DRV_CONTROL_MAGIC_NUMBER,
+                             (char*)proto, sizeof(*proto));
+    }
+
+    driver_set_timer(port_num, 0);
+    return (ErlDrvData)dd;
+}
+#endif
