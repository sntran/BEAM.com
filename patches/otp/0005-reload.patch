+    [#{id => beam_com_reload,
+       start => {beam_com_reload, start_link, []},
+       restart => temporary,
+       shutdown => 2000,
+       type => worker,
+       modules => [beam_com_reload]}].
 
 start_distribution() ->
     Rpc = #{id => rex,
