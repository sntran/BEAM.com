 	memcpy((void *) cmd_line,(void *) name, len);
 	cmd_line[len] = '\0';
 	len = len + 1;
+#ifdef __COSMOPOLITAN__
+	if (access(beam_com_exec_path(cmd_line),X_OK) != 0) {
+#else
 	if (access(cmd_line,X_OK) != 0) {
+#endif
 	    int save_errno = errno;
 	    erts_free(ERTS_ALC_T_TMP, cmd_line);
             close_pipes(ifd, ofd);
@@ -1657,7 +1661,11 @@ static ErlDrvData forker_start(ErlDrvPort port_num, char* name,
     (void) setsid();
 #endif
 
+#ifdef __COSMOPOLITAN__
+        execv(beam_com_exec_path(child_setup_prog), cs_argv);
+#else
         execv(child_setup_prog, cs_argv);
+#endif
         _exit(1);
     }
 
