diff --git a/erts/emulator/beam/sys.h b/erts/emulator/beam/sys.h
index 0d6ae8f..686f0e1 100644
--- a/erts/emulator/beam/sys.h
+++ b/erts/emulator/beam/sys.h
@@ -199,7 +199,9 @@ typedef ERTS_SYS_FD_TYPE ErtsSysFdType;
