+++ b/erts/emulator/sys/unix/erl_child_setup.c
@@ -360,7 +360,11 @@ start_new_child(int pipes[])
 
     if (args) {
         /* spawn_executable */
+#ifdef __COSMOPOLITAN__
+        execve(beam_com_exec_path(cmd), args, new_environ);
