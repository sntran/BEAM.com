diff --git a/erts/configure b/erts/configure
index afa96f2..08207b5 100755
--- a/erts/configure
+++ b/erts/configure
@@ -26631,7 +26631,9 @@ then :
       #
       # On other platforms we'll wrangle sigaltstack(2) to let signals execute
       # on an alternate stack.
-      enable_native_stack=yes
+      # A value from the environment wins (BEAM.com: one binary for all
+      # OSes, OpenBSD too).
+      enable_native_stack=${enable_native_stack:-yes}
      ;;
 esac
 
diff --git a/erts/configure.ac b/erts/configure.ac
index c5113a5..ffb7dc5 100644
--- a/erts/configure.ac
+++ b/erts/configure.ac
@@ -3210,7 +3210,9 @@ AS_IF([test ${enable_jit} != no],
       #
       # On other platforms we'll wrangle sigaltstack(2) to let signals execute
       # on an alternate stack.
-      enable_native_stack=yes
+      # A value from the environment wins (BEAM.com: one binary for all
+      # OSes, OpenBSD too).
+      enable_native_stack=${enable_native_stack:-yes}
     ])
 
   case "$JIT_ARCH" in
diff --git a/erts/emulator/Makefile.in b/erts/emulator/Makefile.in
index 3920b99..9ca7134 100644
