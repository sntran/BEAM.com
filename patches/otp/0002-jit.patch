+ASMJIT_PCH_OBJ=$(TTF_DIR)/asmjit/core.h.stamp
 ASMJIT_PCH_SRC=$(TTF_DIR)/asmjit/core.h
 
 ifeq ($(JIT_ENABLED),yes)
@@ -1045,9 +1047,7 @@ $(OBJDIR)/asmjit/%.o: asmjit/%.cpp $(ASMJIT_PCH_OBJ) $(dir $@)
 ## The dependency on erl_bif_info.c is in order to trigger a rebuild when
