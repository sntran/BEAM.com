+// BEAM.com: true when the directory PATH has an entry that does not wait
+// for its deletion. Such an entry opens, and an entry with a deletion that
+// waits gives an access error. Then RemoveDirectory() fails for a real
+// reason, and a wait does not help. Before, rmdir() of a directory with a
+// file took about 2 s (C68 of docs/UPSTREAM.md).
+static textwindows bool HasLiveEntry(const char16_t *path) {
+  char16_t buf[PATH_MAX];
+  struct NtWin32FindData data;
+  bool live = false;
+  int64_t h, f;
+  size_t n, m;
+  n = strlen16(path);
+  if (n && (path[n - 1] == '\\' || path[n - 1] == '/'))
+    --n;
+  if (n + 2 + ARRAYLEN(data.cFileName) > ARRAYLEN(buf))
+    return false;
+  memcpy(buf, path, n * sizeof(char16_t));
+  buf[n] = '\\';
+  buf[n + 1] = '*';
+  buf[n + 2] = 0;
+  if ((h = FindFirstFile(buf, &data)) == -1)
+    return false;
+  do {
+    if (data.cFileName[0] == '.' &&
+        (!data.cFileName[1] ||
+         (data.cFileName[1] == '.' && !data.cFileName[2])))
+      continue;
+    m = strlen16(data.cFileName);
+    memcpy(buf + n + 1, data.cFileName, (m + 1) * sizeof(char16_t));
+    f = CreateFile(buf, kNtFileReadAttributes,
+                   kNtFileShareRead | kNtFileShareWrite | kNtFileShareDelete,
+                   0, kNtOpenExisting,
+                   kNtFileFlagBackupSemantics | kNtFileFlagOpenReparsePoint,
+                   0);
+    if (f != -1) {
+      CloseHandle(f);
+      live = true;
+    }
+  } while (!live && FindNextFile(h, &data));
+  FindClose(h);
+  return live;
+}
+
