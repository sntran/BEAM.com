+// BEAM.com: up to 64 sockets in arrays on the stack, more in one block
+// of the process heap (libc/calls cannot call malloc(), as ntspawn.c).
+textwindows static int sys_poll_nt_actual(struct pollfd *fds, uint64_t nfds,
+                                          struct timespec deadline,
+                                          sigset_t waitmask) {
+  struct sys_pollfd_nt sockfds[64];
+  int sockindices[64];
+  struct sys_pollfd_nt *bigfds;
+  int rc;
+  if (nfds <= ARRAYLEN(sockfds))
+    return sys_poll_nt_socks(fds, nfds, deadline, waitmask, sockfds,
+                             sockindices, ARRAYLEN(sockfds));
+  bigfds = HeapAlloc(GetProcessHeap(), 0,
+                     nfds * (sizeof(*bigfds) + sizeof(int)));
+  if (!bigfds)
+    return enomem();
+  rc = sys_poll_nt_socks(fds, nfds, deadline, waitmask, bigfds,
+                         (int *)(bigfds + nfds), nfds);
+  HeapFree(GetProcessHeap(), 0, bigfds);
+  return rc;
+}
