-  // clumsy path
+  // clumsy path: parts of 63 fds, so that each part has 63 files or fewer
   for (;;) {
-    for (i = 0; i < nfds; i += 64) {
+    for (i = 0; i < nfds; i += 63) {
       n = nfds - i;
-      n = n > 64 ? 64 : n;
+      n = n > 63 ? 63 : n;
       rc = sys_poll_nt_actual(fds + i, n, timespec_zero, waitmask);
       if (rc == -1)
         return -1;
@@ -353,7 +385,12 @@
     } else {
       target = next;
     }
-    if (_park_norestart(target, waitmask) == -1)
+    // BEAM.com: _park_norestart() takes a time of the wall clock, as in
+    // clock_nanosleep-nt.c. A time of the monotonic clock is a date in
+    // 1970, so the wait ended at once, and this loop used a whole CPU.
+    sys_clock_gettime_nt(0, &wall);
+    if (_park_norestart(timespec_add(wall, timespec_sub(target, now)),
