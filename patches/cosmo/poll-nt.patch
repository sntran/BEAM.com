+// BEAM.com: the arrays of the sockets come from the caller, with room
+// for SOCKCAP sockets. WSAPoll() takes any count of sockets; only the
+// files and pipes of WaitForMultipleObjects() have a limit of 63.
+textwindows static int sys_poll_nt_socks(struct pollfd *fds, uint64_t nfds,
+                                         struct timespec deadline,
+                                         sigset_t waitmask,
+                                         struct sys_pollfd_nt *sockfds,
+                                         int *sockindices, uint64_t sockcap) {
   int fileindices[64];
-  int sockindices[64];
   int64_t filehands[64];
   struct PosixThread *pt;
   int i, rc, ev, kind, gotsocks;
-  struct sys_pollfd_nt sockfds[64];
   uint32_t cm, fi, sn, pn, avail, waitfor, already_slept;
 
   // ensure revents is cleared
@@ -103,7 +107,7 @@
       kind = g_fds.p[fds[i].fd].kind;
       if (kind == kFdSocket) {
         // we can use WSAPoll() for these fds
-        if (sn < ARRAYLEN(sockfds)) {
+        if (sn < sockcap) {
           // WSAPoll whines if we pass POLLNVAL, POLLHUP, or POLLERR.
           sockindices[sn] = i;
           sockfds[sn].handle = g_fds.p[fds[i].fd].handle;
@@ -315,11 +319,33 @@
