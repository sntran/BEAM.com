libc/calls/unveil.c of Cosmopolitan 4.0.2, for beam.com (the function
build_cosmo_file of scripts/steps.sh, C50 of docs/UPSTREAM.md):

- The permission "c" also gives the Landlock rights REMOVE_FILE and
  REMOVE_DIR, as "c" of unveil() of OpenBSD allows the removal of files.
  The ruleset of upstream does not handle these rights, so Landlock did
  not control unlink() and rmdir(): with each sandbox, the program could
  delete each file and each empty directory of its user.

--- a/libc/calls/unveil.c
+++ b/libc/calls/unveil.c
@@ -66,11 +66,16 @@
 #define UNVEIL_WRITE \
   (LANDLOCK_ACCESS_FS_WRITE_FILE | LANDLOCK_ACCESS_FS_TRUNCATE)
 #define UNVEIL_EXEC (LANDLOCK_ACCESS_FS_EXECUTE)
+// BEAM.com: "c" also allows the removal of a file and of a directory,
+// as unveil() of OpenBSD does. Without these rights in the ruleset,
+// Landlock did not control unlink() and rmdir(), so each sandbox let the
+// program delete each file of its user.
 #define UNVEIL_CREATE                                             \
   (LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR |   \
    LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK |   \
    LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK | \
-   LANDLOCK_ACCESS_FS_MAKE_SYM)
+   LANDLOCK_ACCESS_FS_MAKE_SYM | LANDLOCK_ACCESS_FS_REMOVE_DIR |   \
+   LANDLOCK_ACCESS_FS_REMOVE_FILE)
 
 #define FILE_BITS                                                 \
   (LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_WRITE_FILE | \
