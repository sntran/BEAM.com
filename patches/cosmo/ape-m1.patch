+/* BEAM.com: the arguments and the environment of the loader, for
+   Respawn(). */
+static char **g_argv, **g_envp;
+
+/* BEAM.com: the addresses of a program with fixed addresses
+   (IMAGE_BASE_VIRTUAL of Cosmopolitan), reserved with PROT_NONE at the
+   start of main(), so that the malloc() of libSystem does not put a
+   region there before Spawn() maps the program. */
+#define RESERVE_BASE 0x800000000ul
+#define RESERVE_SIZE 0x1000000ul
+static int g_reserved;
+
+/* BEAM.com: 1 when MAP_FIXED can map [A, B): each part of it is free,
+   or is a reserved part of the shared region (in a submap, with no
+   access and no tag). macOS 27 reserves the address space of the shared
+   region up to 0xfc0000000, and the fixed addresses of the program
+   (0x800000000) are in it. Its mmap() takes no hint below 0x7000000000,
+   also for free memory, and mach_vm_allocate() with VM_FLAGS_FIXED
+   refuses the reservation. */
+static int RangeUsable(unsigned long a, unsigned long b) {
+  mach_vm_address_t r = a;
+  while (r < b) {
+    mach_vm_address_t addr = r;
+    mach_vm_size_t size = 0;
+    natural_t depth = 64;
+    vm_region_submap_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+    kern_return_t kr;
+    kr = mach_vm_region_recurse(mach_task_self(), &addr, &size, &depth,
+                                (vm_region_recurse_info_t)&info, &count);
+    if (kr == KERN_INVALID_ADDRESS)
+      return 1;
+    if (kr != KERN_SUCCESS || addr + size <= r)
+      return 0;
+    if (addr >= b)
+      return 1;
+    if (depth == 0 || info.is_submap || info.max_protection != VM_PROT_NONE ||
+        info.user_tag != 0)
+      return 0;
+    r = addr + size;
+  }
+  return 1;
+}
+extern char **environ;
+
+/* BEAM.com: start the loader again, in a new process with a new layout
+   of its address space. A part of the fixed addresses of the program is
+   in use (see Spawn). APE_LOADER_TRIES counts the tries, at most 64.
+   On macOS 26, the range is in use in about 7 starts of 10, and each
+   new start costs about 4 ms. */
+__attribute__((__noreturn__)) static void Respawn(const char *exe) {
+  char path[PATH_MAX], count[8];
+  uint32_t size = sizeof(path);
+  const char *tries = getenv("APE_LOADER_TRIES");
+  int n = tries ? atoi(tries) : 0;
+  if (n >= 64)
+    Pexit(exe, 0, "the fixed addresses of the program are in use");
+  count[0] = '0' + (n + 1) / 10;
+  count[1] = '0' + (n + 1) % 10;
+  count[2] = 0;
+  if (_NSGetExecutablePath(path, &size))
+    Pexit(exe, 0, "the path of the APE loader is too long");
+  setenv("APE_LOADER_TRIES", count, 1);
+  execve(path, g_argv, environ);
+  Pexit(exe, -errno, "execve of the APE loader");
+}
+
 __attribute__((__noreturn__)) static void Spawn(const char *exe, int fd,
                                                 long *sp, struct ElfEhdr *e,
                                                 struct ElfPhdr *p,
@@ -664,6 +735,38 @@
     dynbase = 0;
   }
 
+  /* BEAM.com: each range of a program with fixed addresses must be
+     free. MAP_FIXED of XNU replaces a mapping that is there, for
+     example a region of the malloc zones of libSystem, which this
+     loader can have made already. Then the malloc() of libSystem gives
+     out blocks in the memory of the program, and a call of libSystem
+     (sandbox_init(), os_log()) writes over its data (issue 177). A
+     mapping without MAP_FIXED gets the hint only when it is free. On
+     macOS 27 no hint below 0x7000000000 works, so RangeUsable() checks
+     the range, and MAP_FIXED maps it. */
+  if (g_reserved) {
+    sys_munmap((void *)RESERVE_BASE, RESERVE_SIZE);
+    g_reserved = 0;
+  }
+  if (e->e_type != ET_DYN) {
+    for (i = 0; i < e->e_phnum; ++i) {
+      if (p[i].p_type != PT_LOAD)
+        continue;
+      a = p[i].p_vaddr & -pagesz;
+      b = (p[i].p_vaddr + p[i].p_memsz + (pagesz - 1)) & -pagesz;
+      rc = sys_mmap((void *)a, b - a, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS,
+                    -1, 0);
+      if (rc != (long)a) {
+        if (rc >= 0)
+          sys_munmap((void *)rc, b - a);
+        if (!RangeUsable(a, b) ||
+            sys_mmap((void *)a, b - a, PROT_NONE,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != (long)a)
+          Respawn(exe);
+      }
+    }
+  }
+
