select() of Cosmopolitan on Windows (libc/calls/select-nt.c, C61 and C63
of docs/UPSTREAM.md):

- The array of the fds had 128 entries, and select() of 129 fds or more
  failed with E2BIG. ERTS then logged "erts_poll_wait() failed" in a loop,
  and no socket or port got an event. Now the array has an entry for each
  fd of the sets: on the stack for 128 fds or fewer, else on the heap.
  An array of FD_SETSIZE entries on the stack (8 KiB) is above the limit
  of 4096 bytes for a frame of the libc.
- The libc reported an error or a hangup of an fd only in readfds, also
  when the fd was only in writefds. A wait for POLLOUT alone (a send that
  waits for room) thus never saw the reset of the connection. Now, as on
  Linux, an error or a hangup makes the fd ready in each set that asked
  for it, and an fd is ready only in a set that asked for it.

scripts/steps.sh builds the file with this patch for the x86_64 half
(build_cosmo_file), and applies it to the libc of Windows on ARM64
(build_cosmo_libc).

--- a/libc/calls/select-nt.c
+++ b/libc/calls/select-nt.c
@@ -21,6 +21,7 @@
 #include "libc/calls/struct/timeval.h"
 #include "libc/limits.h"
 #include "libc/macros.h"
+#include "libc/nt/memory.h"
 #include "libc/sock/select.h"
 #include "libc/sock/sock.h"
 #include "libc/sock/struct/pollfd.h"
@@ -48,7 +49,21 @@
   int pfds = 0;
 
   // convert bitsets to pollfd
-  struct pollfd fds[128];
+  // BEAM.com: an entry for each fd of the sets. The libc had an array of
+  // 128 on the stack, and select() of 129 fds or more failed with E2BIG.
+  // Above 128 fds, the array is in the process heap (libc/calls cannot
+  // call malloc(), as ntspawn.c).
+  struct pollfd stackfds[128];
+  struct pollfd *fds = stackfds;
+  int want = 0;
+  for (int fd = 0; fd < nfds; ++fd)
+    if ((readfds && FD_ISSET(fd, readfds)) ||
+        (writefds && FD_ISSET(fd, writefds)) ||
+        (exceptfds && FD_ISSET(fd, exceptfds)))
+      ++want;
+  if (want > ARRAYLEN(stackfds) &&
+      !(fds = HeapAlloc(GetProcessHeap(), 0, want * sizeof(*fds))))
+    return enomem();
   for (int fd = 0; fd < nfds; ++fd) {
     int events = 0;
     if (readfds && FD_ISSET(fd, readfds))
@@ -58,8 +73,6 @@
     if (exceptfds && FD_ISSET(fd, exceptfds))
       events |= POLLPRI_;
     if (events) {
-      if (pfds == ARRAYLEN(fds))
-        return e2big();
       fds[pfds].fd = fd;
       fds[pfds].events = events;
       fds[pfds].revents = 0;
@@ -69,8 +82,11 @@
 
   // call our nt poll implementation
   int fdcount = sys_poll_nt(fds, pfds, timeout, sigmask);
-  if (fdcount == -1)
+  if (fdcount == -1) {
+    if (fds != stackfds)
+      HeapFree(GetProcessHeap(), 0, fds);
     return -1;
+  }
 
   // convert pollfd back to bitsets
   if (readfds)
@@ -80,20 +96,26 @@
   if (exceptfds)
     FD_ZERO(exceptfds);
   int bits = 0;
+  // BEAM.com: as on Linux, an error or a hangup makes the fd ready in
+  // each set that asked for it, and an fd is ready only in such a set.
+  // The libc reported an error only in readfds, so a wait for POLLOUT
+  // alone never saw it.
   for (int i = 0; i < pfds; ++i) {
-    if (fds[i].revents & (POLLIN_ | POLLHUP_ | POLLERR_ | POLLNVAL_)) {
+    if ((fds[i].revents & (POLLIN_ | POLLHUP_ | POLLERR_ | POLLNVAL_)) &&
+        (fds[i].events & POLLIN_)) {
       if (readfds) {
         FD_SET(fds[i].fd, readfds);
         ++bits;
       }
     }
-    if (fds[i].revents & POLLOUT_) {
+    if ((fds[i].revents & (POLLOUT_ | POLLHUP_ | POLLERR_ | POLLNVAL_)) &&
+        (fds[i].events & POLLOUT_)) {
       if (writefds) {
         FD_SET(fds[i].fd, writefds);
         ++bits;
       }
     }
-    if (fds[i].revents & POLLPRI_) {
+    if ((fds[i].revents & POLLPRI_) && (fds[i].events & POLLPRI_)) {
       if (exceptfds) {
         FD_SET(fds[i].fd, exceptfds);
         ++bits;
@@ -101,5 +123,7 @@
     }
   }
 
+  if (fds != stackfds)
+    HeapFree(GetProcessHeap(), 0, fds);
   return bits;
 }
