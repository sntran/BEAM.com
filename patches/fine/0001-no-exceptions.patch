 #include <erl_nif.h>
 
+// BEAM.com: an error path without C++ exceptions, for targets that have
+// none (wasm32-wasip1). With FINE_NO_EXCEPTIONS, FINE_THROW records a
+// pending error and returns a placeholder value. The NIF wrapper raises
+// the pending error. A function that gets a placeholder value must
+// check FINE_FAILED() before it uses the value.
+namespace fine {
+class Atom;
+namespace __private__ {
+enum class ErrorKind { none, invalid_argument, runtime_error, term };
+
+struct PendingError {
+  ErrorKind kind = ErrorKind::none;
+  std::string message;
+  ERL_NIF_TERM term = 0;
+};
+
+// A NIF library in WebAssembly runs one call at a time.
+inline PendingError pending_error = {};
+
+inline bool failed() noexcept {
+  return pending_error.kind != ErrorKind::none;
+}
+
+inline void clear_error() noexcept {
+  pending_error.kind = ErrorKind::none;
+  pending_error.message.clear();
+  pending_error.term = 0;
+}
+
+// The first error wins, as the first throw wins.
+inline void fail(ErrorKind kind, std::string message) {
+  if (!failed()) {
+    pending_error.kind = kind;
+    pending_error.message = std::move(message);
+  }
+}
+
+inline void fail_term(ERL_NIF_TERM term) {
+  if (!failed()) {
+    pending_error.kind = ErrorKind::term;
+    pending_error.term = term;
+  }
+}
+
+template <typename T> struct FailedValue {
+  static T get() { return T{}; }
+};
+
+// Converts to the return type of the function that fails.
+struct AnyFailedValue {
+  template <typename T> operator T() const { return FailedValue<T>::get(); }
+};
+} // namespace __private__
+} // namespace fine
+
+#ifdef FINE_NO_EXCEPTIONS
+#define FINE_THROW(kind, ...)                                                  \
+  do {                                                                         \
+    ::fine::__private__::fail(::fine::__private__::ErrorKind::kind,            \
+                              __VA_ARGS__);                                    \
+    return ::fine::__private__::AnyFailedValue{};                             \
+  } while (0)
+#define FINE_THROW_VOID(kind, ...)                                             \
+  do {                                                                         \
+    ::fine::__private__::fail(::fine::__private__::ErrorKind::kind,            \
+                              __VA_ARGS__);                                    \
+    return;                                                                    \
+  } while (0)
+#define FINE_FAILED() (::fine::__private__::failed())
+#else
+#define FINE_THROW(kind, ...) throw std::kind(__VA_ARGS__)
+#define FINE_THROW_VOID(kind, ...) throw std::kind(__VA_ARGS__)
+#define FINE_FAILED() false
+#endif
+
 #if defined(_MSVC_LANG)
 #define CPP_VERSION _MSVC_LANG
 #else
