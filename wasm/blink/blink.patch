diff --git a/blink/syscall.c b/blink/syscall.c
index 34cc01c..8f022b2 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -152,11 +152,32 @@ static int SystemIoctl(int fd, unsigned long request, ...) {
 // back to the main loop. Yield regularly when the process waits for some
 // user input.
 
+#ifdef __EMSCRIPTEN_PTHREADS__
+// With pthreads (and PROXY_TO_PTHREAD), this thread is not the main thread
+// of the host, so it can block. The poll() of Emscripten does not wait for
+// its timeout: wait here, in short steps.
+int em_poll(struct pollfd *fds, nfds_t nfds, int timeout) {
+  struct timespec t0, t1;
+  long step = 100, ms;
+  int ret;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  for (;;) {
+    if ((ret = VfsPoll(fds, nfds, 0)) != 0 || timeout == 0) return ret;
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    ms = (t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000;
+    if (timeout > 0 && ms >= timeout) return 0;
+    usleep(step);
+    if (step < 5000) step *= 2;
+  }
+}
+#define emscripten_sleep(ms) usleep((ms) * 1000)
+#else
 int em_poll(struct pollfd *fds, nfds_t nfds, int timeout) {
   int ret = VfsPoll(fds, nfds, timeout);
   if (ret == 0) emscripten_sleep(50);
   return ret;
 }
+#endif
 
 ssize_t em_readv(int fd, const struct iovec *iov, int iovcnt) {
   // Handle blocking reads by waiting for POLLIN
@@ -362,6 +383,11 @@ _Noreturn void SysExitGroup(struct Machine *m, int rc) {
     _Exit(rc);
   } else {
     THR_LOGF("calling exit(%d)", rc);
+#ifdef __EMSCRIPTEN_PTHREADS__
+    // The host threads of Emscripten get no signals, so the other threads
+    // cannot be stopped: end the whole runtime (all the Workers) now.
+    emscripten_force_exit(rc);
+#endif
     KillOtherThreads(m->system);
 #ifdef HAVE_JIT
     DisableJit(&m->system->jit);  // unmapping exec pages is slow
