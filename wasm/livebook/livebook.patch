+  # With +Mea min (a VM in a Cloudflare Worker, where memory is scarce),
+  # :erlang.memory/0 is not supported: an estimate from the processes,
+  # the ETS tables and the allocated areas.
+  @doc false
+  def erlang_memory() do
+    Map.new(:erlang.memory())
+  rescue
+    ErlangError ->
+      areas = Map.new(:erlang.system_info(:allocated_areas), &{elem(&1, 0), elem(&1, 1)})
+
+      processes =
+        Enum.sum(for pid <- Process.list(), {:memory, m} <- [Process.info(pid, :memory)], do: m)
+
+      ets =
+        Enum.sum(for t <- :ets.all(), w = :ets.info(t, :memory), is_integer(w), do: w) *
+          :erlang.system_info(:wordsize)
+
+      atom = Map.get(areas, :atom_space, 0) + Map.get(areas, :atom_table, 0)
+      code = Map.get(areas, :loaded_code, 0) + Map.get(areas, :module_table, 0)
+      other = Enum.sum(Map.values(areas)) - atom - code
+
+      %{total: processes + ets + atom + code + other, processes: processes, atom: atom,
+        binary: 0, code: code, ets: ets}
+  end
